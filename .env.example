# Database connection URL (PostgreSQL)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/whiteboard

# Server configuration
PORT=8080
TICKET_SECRET=secret-ticket-signing-key-minimum-32-bytes-long!
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
LOG_LEVEL=info

# Set to true only in testing environments where PostgreSQL is not available
ALLOW_IN_MEMORY_DB=false

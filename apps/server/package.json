{
  "name": "@whiteboard/server",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --watch ./dist/main.js",
    "build": "tsc",
    "start": "node ./dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.6",
    "@whiteboard/shared": "workspace:*",
    "fastify": "^5.2.1",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.3",
    "pg-mem": "^3.0.14",
    "pino": "^9.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.5.14",
    "pg-mem": "^3.0.14",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
